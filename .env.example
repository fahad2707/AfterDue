# =============================================================================
# RECLAIM — environment template
#
# This file is committed. It must NEVER contain real values.
#
#   cp .env.example .env                              # backend reads this
#   cp frontend/.env.local.example frontend/.env.local # frontend reads that
#
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_ENV=local
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# MongoDB Atlas
# Format: mongodb+srv://<user>:<password>@<cluster>/?retryWrites=true&w=majority
# -----------------------------------------------------------------------------
MONGODB_URI=
MONGODB_DB=reclaim

# -----------------------------------------------------------------------------
# Transport security
#
# INTERNAL_API_KEY is the shared secret between the Next.js server-side proxy
# and FastAPI. The browser never sees it. Must match frontend/.env.local.
# -----------------------------------------------------------------------------
INTERNAL_API_KEY=
CORS_ORIGINS=http://localhost:3000

# -----------------------------------------------------------------------------
# LLM (language layer only — never on the measured economic decision path)
#
# The economic comparison must run correctly with LLM_ENABLED=false.
# -----------------------------------------------------------------------------
LLM_ENABLED=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
LLM_TIMEOUT_SECONDS=8

# -----------------------------------------------------------------------------
# Deterministic core (populated in later milestones)
# -----------------------------------------------------------------------------
POLICY_VERSION=v1
POLICY_MAX_ATTEMPTS=3
MAX_RECOVERY_ATTEMPTS=3
AGENT_HARD_ITERATION_CAP=4
POLICY_CONTACT_COOLDOWN_HOURS=24
MODEL_ARTIFACT_PATH=app/ml/artifacts/recovery_model.joblib
SIM_DEFAULT_SEED=42
INTERVENTION_BUDGET_DEFAULT=150
