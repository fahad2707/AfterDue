# cp frontend/.env.local.example frontend/.env.local
#
# Neither of these may be prefixed with NEXT_PUBLIC_. They are read only by
# the Next.js server (Server Components and the /api proxy route).

RECLAIM_API_URL=http://127.0.0.1:8000

# Must match INTERNAL_API_KEY in the repo-root .env
INTERNAL_API_KEY=

NEXT_PUBLIC_APP_ENV=local
